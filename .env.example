# Cron protection
CRON_SECRET=""

# 32+ byte secret for AES-GCM field encryption of sensitive case/report/privacy text.
SINAPVE_FIELD_ENCRYPTION_KEY=""

# Shared secret used by the institutional identity gateway to sign identity
# headers (HMAC-SHA256). When set, the app rejects unsigned/invalid identity.
# Leave empty for local development (signing disabled).
SINAPVE_GATEWAY_SIGNING_KEY=""

# Supervised AI via a provider-agnostic AI Gateway (OpenAI-compatible chat API,
# e.g. Vercel AI Gateway). When both are empty, AI stays disabled and human
# flows continue (safe fallback).
SINAPVE_AI_GATEWAY_URL=""
SINAPVE_AI_GATEWAY_KEY=""
SINAPVE_AI_MODEL=""

# OIDC/SAML relying party (Auth.js). When these are unset the app keeps the
# gateway/dev identity model (no login provider is registered). The identity
# provider is external; only the integration lives here. Roles and scope come
# from the sinapve_roles / sinapve_organization_id / sinapve_* claims.
AUTH_SECRET=""
SINAPVE_OIDC_ISSUER=""
SINAPVE_OIDC_CLIENT_ID=""
SINAPVE_OIDC_CLIENT_SECRET=""
SINAPVE_OIDC_SCOPE="openid profile email"
