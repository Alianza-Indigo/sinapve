# Cron protection
CRON_SECRET=""

# 32+ byte secret for AES-GCM field encryption of sensitive case/report/privacy text.
SINAPVE_FIELD_ENCRYPTION_KEY=""

# Shared secret used by the institutional identity gateway to sign identity
# headers (HMAC-SHA256). When set, the app rejects unsigned/invalid identity.
# Leave empty for local development (signing disabled).
SINAPVE_GATEWAY_SIGNING_KEY=""

# Supervised AI via a provider-agnostic AI Gateway (OpenAI-compatible chat API,
# e.g. Vercel AI Gateway). When both are empty, AI stays disabled and human
# flows continue (safe fallback).
SINAPVE_AI_GATEWAY_URL=""
SINAPVE_AI_GATEWAY_KEY=""
SINAPVE_AI_MODEL=""

# OIDC/SAML relying party (Auth.js). When these are unset the app keeps the
# gateway/dev identity model (no login provider is registered). The identity
# provider is external; only the integration lives here. Roles and scope come
# from the sinapve_roles / sinapve_organization_id / sinapve_* claims.
AUTH_SECRET=""
SINAPVE_OIDC_ISSUER=""
SINAPVE_OIDC_CLIENT_ID=""
SINAPVE_OIDC_CLIENT_SECRET=""
SINAPVE_OIDC_SCOPE="openid profile email"

# Admin bootstrap (login interino en /login) para operar la consola antes del
# IdP definitivo. Requiere AUTH_SECRET. La contraseña se guarda como hash scrypt:
#   corepack pnpm --filter @sinapve/web admin:hash 'TU_CLAVE_FUERTE'
# Los roles deben incluir uno con analytics:read para ver el tablero (p.ej. FEDERAL).
SINAPVE_ADMIN_EMAIL=""
SINAPVE_ADMIN_PASSWORD_HASH=""
SINAPVE_ADMIN_ROLES="FEDERAL"
SINAPVE_ADMIN_NAME="Administrador SINAPVE"
SINAPVE_ADMIN_ORG=""

# Antivirus/sandbox for attachments. When set, evidence buffers are scanned by
# the external scanner; without it, only the local EICAR heuristic runs.
SINAPVE_AV_SCAN_URL=""
SINAPVE_AV_SCAN_KEY=""

# Multichannel notification providers (webhooks). in_app always works; external
# channels are queued only when their webhook is set. Only a safe summary is sent.
SINAPVE_EMAIL_WEBHOOK=""
SINAPVE_SMS_WEBHOOK=""
SINAPVE_PUSH_WEBHOOK=""
SINAPVE_VOICE_WEBHOOK=""

# (Los insumos analíticos —INRE, encuestas, matrícula, permanencia, impacto,
# presupuesto— se capturan por API en /api/v1/analytics/inputs; no usan variables.)

# Native durable queue (e.g. Vercel Queues). The PostgreSQL outbox is the source
# of truth; when a native queue is bound, an enqueue also publishes a drain
# notice. The drain endpoint (/api/v1/queues/drain) is protected by CRON_SECRET.
SINAPVE_QUEUE_PUBLISH_URL=""
SINAPVE_QUEUE_TOKEN=""
